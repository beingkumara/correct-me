# Copy to .env and fill in your Groq key (https://console.groq.com/keys). Never commit .env.
READER_BASE_URL=https://api.groq.com/openai/v1
READER_API_KEY=
READER_MODEL=qwen/qwen3.8-27b
# Qwen loops under strict json_schema with an image; plain JSON mode + our validator works.
READER_JSON_MODE=json_object
CHECKER_BASE_URL=https://api.groq.com/openai/v1
CHECKER_API_KEY=
CHECKER_MODEL=openai/gpt-oss-120b
CHECKER_JSON_MODE=json_schema
PORT=3000
